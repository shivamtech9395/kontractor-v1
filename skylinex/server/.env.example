# ============================================================
# KONTRACTOR BACKEND SERVER ENVIRONMENT VARIABLES
# ============================================================
PORT=5000

# MongoDB Atlas Production Connection URI
# Replace <db_username> and <db_password> with your MongoDB Atlas database credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/kontractor?retryWrites=true&w=majority

# Node Environment
NODE_ENV=production
